<?xml version="1.0" encoding="utf-8"?>

<manifest 
    xmlns:android="http://schemas.android.com/apk/res/android" 
    xmlns:tools="http://schemas.android.com/tools">
    
        <uses-permission android:name="android.permission.INTERNET" />
        <!-- Needed to run a foreground service at all -->
        <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
        <!-- Android 14+ requires a declared type; specialUse has no time limit (dataSync is capped at 6h on Android 15) -->
        <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
        <!-- Android 13+: needed so the service notification is visible -->
        <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
        <!-- Keeps the CPU awake while the screen is off -->
        <uses-permission android:name="android.permission.WAKE_LOCK" />
        <!-- Lets the app show the system dialog that exempts it from battery optimization -->
        <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
        <!-- All files access (Android 11+): lets a workspace point to any folder on shared storage -->
        <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
        <!-- Android 10 and older use the classic storage permissions instead -->
        <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
        <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
        <!-- Lets AI MCP run commands in Termux (the permission is defined by the Termux app) -->
        <uses-permission android:name="com.termux.permission.RUN_COMMAND" />
        <!-- Needed to find Termux builds with a different package name (fine for sideloaded apps) -->
        <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
        
        <queries>
            <package android:name="com.termux" />
        </queries>
    <application 
        android:allowBackup="false" 
        android:icon="@mipmap/ic_launcher" 
        android:roundIcon="@mipmap/ic_launcher" 
        android:label="@string/app_name" 
        android:supportsRtl="true" 
        android:requestLegacyExternalStorage="true"
        android:theme="@style/AppTheme">
        <activity 
            android:name="MainActivity"
            android:exported="true">
            <intent-filter>
                <action 
                    android:name="android.intent.action.MAIN" />
                <category 
                    android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        
        <service
            android:name=".service.McpForegroundService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <!-- Required explanation for the specialUse type -->
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Local MCP server giving an AI assistant access to a user-approved folder" />
        </service>
        
        <!-- Receives the result of Termux commands; only the system can deliver to it -->
        <receiver
            android:name=".tools.termux.TermuxResultReceiver"
            android:exported="false" />
    </application>
</manifest>