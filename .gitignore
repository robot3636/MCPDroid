# MCPDroid additions
# ---------------------------------------------------------------

# Signing secrets: never commit these
*.keystore
*.jks
release.properties
keystore.properties

# Build output of every module (the rule above only covers the root)
build/

# Local tool folders
.cg/
.kotlin/


# AndroidIDE internal state and editor backup files
.androidide/
*.bak

# Patched cloudflared binary: generate it with the script from
